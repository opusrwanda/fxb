# Bunny.net storage + CDN. Copy to .env.local and fill in real values.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_READONLY_PASSWORD=

# Public pull-zone hostname that serves the uploaded assets.
NEXT_PUBLIC_CDN_URL=

# Newsletter signup. Until NEWSLETTER_ENDPOINT is set, the footer form refuses
# rather than silently dropping addresses. Point it at the mailing provider's
# subscribe URL; add NEWSLETTER_TOKEN if that provider needs a bearer key.
NEWSLETTER_ENDPOINT=
NEWSLETTER_TOKEN=
