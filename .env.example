# Bunny.net storage + CDN. Copy to .env.local and fill in real values.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_READONLY_PASSWORD=

# Public pull-zone hostname that serves the uploaded assets.
NEXT_PUBLIC_CDN_URL=



# The CMS at /staff. Postgres — locally this can be a database on your own
# machine; in production use Neon or Vercel Postgres (both have a free tier
# large enough for this site many times over).
#
# `STAFF_DATABASE_URL` is the one the panel reads; `DATABASE_URL` is the
# fallback, so a deploy that only sets the latter still works. They are two
# names because the panel was built alongside the Payload database it replaced
# and the two schemas want the same table names. Nothing reads Payload's any
# more — see docs/cms.md for what is left of that changeover.
STAFF_DATABASE_URL=postgres://<you>@localhost:5432/fxb
DATABASE_URL=

# ── Email ───────────────────────────────────────────────────────────────────
# Any SMTP server. Port 587 is STARTTLS and 465 is TLS from the first byte;
# the transport picks the right mode from the port. See docs/email.md.
#
# Gmail        smtp.gmail.com          587   ~500/day free, ~2,000 Workspace
#              Password MUST be a 16-character App Password, not the account
#              password: turn on 2-Step Verification, then create one at
#              myaccount.google.com/apppasswords.
#
# Outlook.com  smtp-mail.outlook.com   587   ~300 recipients/day
# Microsoft365 smtp.office365.com      587   ~10,000 recipients/day
#              Microsoft lists the authentication method as OAuth2/Modern
#              Auth. A username and password still works only where SMTP AUTH
#              is enabled for the mailbox, and on a personal account that
#              usually means an app password with 2FA on. If it is switched
#              off the server answers 5.7.139 and no password will fix it —
#              an administrator has to enable it for that mailbox.
#
# MAIL_FROM_ADDRESS must be the mailbox that is signing in, or an address it is
# allowed to send as. Both Google and Microsoft rewrite or reject anything else.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="FXB Rwanda"
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=

# Messages per minute. Microsoft throttles a mailbox at 30 and temporarily
# blocks anything faster; Gmail tolerates far more. The default is the lower
# of the two.
MAIL_RATE_PER_MINUTE=30

# Used to build unsubscribe links in emails. Must be the public address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
