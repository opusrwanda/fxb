# Bunny.net storage + CDN. Copy to .env.local and fill in real values.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_READONLY_PASSWORD=

# Public pull-zone hostname that serves the uploaded assets.
NEXT_PUBLIC_CDN_URL=


# Contact form. Same rule as the newsletter: until CONTACT_ENDPOINT is set, the
# form refuses and tells the visitor to email the office, rather than showing a
# thank-you and dropping the message. Point it at a transactional mail API or
# form service; add CONTACT_TOKEN if that provider needs a bearer key.
CONTACT_ENDPOINT=
CONTACT_TOKEN=

# The CMS at /staff. Postgres — locally this can be a database on your own
# machine; in production use Neon or Vercel Postgres (both have a free tier
# large enough for this site many times over).
DATABASE_URL=

# Signs the /staff login sessions. Any long random string, kept private.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# The new staff panel's database, while it is built alongside Payload's.
STAFF_DATABASE_URL=postgres://<you>@localhost:5432/fxb

# ── Email ───────────────────────────────────────────────────────────────────
# Gmail SMTP. The password MUST be a 16-character App Password, not the account
# password: enable 2-Step Verification, then create one at
# myaccount.google.com/apppasswords. See docs/email.md.
#
# Gmail caps sending at ~500 recipients/day (free) or ~2,000 (Workspace).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME="FXB Rwanda"
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=

# Used to build unsubscribe links in emails. Must be the public address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
